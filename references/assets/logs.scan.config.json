{
  "include": ["**/*.log", "**/*.log.*", "**/logs/**", "**/log/**", "**/*.out", "**/*.err", "**/*.trace", "**/*.evtx", "**/events/**/*.jsonl", "**/events/**/*.ndjson", "**/*events*.jsonl", "**/*events*.ndjson", "**/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.jsonl", "**/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]*.ndjson"],
  "oversize": "tail",
  "edge_patterns": [
    {
      "kind": "log_level",
      "exclude": ["**/*.evtx"],
      "regex": "\\b(FATAL|CRITICAL|ERROR|WARN(?:ING)?)\\b"
    },
    {
      "kind": "logged_exception",
      "exclude": ["**/*.evtx"],
      "regex": "\\b([A-Z][A-Za-z]+(?:Error|Exception))\\b"
    }
  ]
}
